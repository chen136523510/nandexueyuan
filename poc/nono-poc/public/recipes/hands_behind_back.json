    { "op": "rotate", "bone": "rightUpperArm", "axis": "z", "deg": 42,  "dur": 0.5,  "delay": 0.35 },
    { "op": "bend",   "bone": "leftLowerArm",  "axis": "y", "deg": 50,  "dur": 0.5,  "delay": 0.5 },
    { "op": "bend",   "bone": "rightLowerArm", "axis": "y", "deg": -50, "dur": 0.5,  "delay": 0.5 },
    { "op": "bend",   "bone": "leftLowerArm",  "axis": "z", "deg": -28, "dur": 0.45, "delay": 0.65 },
    { "op": "bend",   "bone": "rightLowerArm", "axis": "z", "deg": 28,  "dur": 0.45, "delay": 0.65 }
  ]
