{
  "id": "walk_loop",
  "label": "行走",
  "version": 1,
  "hold": true,
  "interruptible": true,
  "mirrorable": false,
  "layer": "gesture",
  "channels": { "expression": null, "breath": null },
  "ref": "白盒步态循环（程序化 pingPong 环，BUG-095 院长裁决'移动不要平移，搞一点正常的行走动作'）：双腿 x 摆 ±26° 相位差半周期、摆动腿屈膝、双臂反相摆、髋部每步起浮、躯干微前倾；引擎 loop=-1=无限 pingPong，打断=150ms 滑变收势。步幅≈2×0.408×sin26°≈0.36m/步 ×2步/0.7s 周期 ≈1.03m/s 与 room.WALK_SPEED 1.05 匹配减小滑步感。正式步态 clip（Blender/Mixamo/GVHMR 自研管线）到位后由 mixer 路径替换本配方（接口不变：行走期间播、到达 stop 收势）",
  "sequence": [
    { "op": "rotate",    "bone": "leftUpperLeg",  "axis": "x", "deg": -26,  "dur": 0.35, "loop": -1 },
    { "op": "rotate",    "bone": "rightUpperLeg", "axis": "x", "deg": -26,  "dur": 0.35, "loop": -1, "delay": 0.35 },
    { "op": "bend",      "bone": "leftLowerLeg",  "axis": "x", "deg": 32,   "dur": 0.35, "loop": -1 },
    { "op": "bend",      "bone": "rightLowerLeg", "axis": "x", "deg": 32,   "dur": 0.35, "loop": -1, "delay": 0.35 },
    { "op": "rotate",    "bone": "leftUpperArm",  "axis": "x", "deg": 16,   "dur": 0.35, "loop": -1, "delay": 0.35 },
    { "op": "rotate",    "bone": "rightUpperArm", "axis": "x", "deg": 16,   "dur": 0.35, "loop": -1 },
    { "op": "translate", "bone": "hips", "y": -0.016, "dur": 0.175, "loop": -1 },
    { "op": "rotate",    "bone": "chest", "axis": "x", "deg": 3, "dur": 0.2 }
  ]
}
