    { "op": "rotate",    "bone": "rightUpperArm", "axis": "x", "deg": 16,  "from": -20, "dur": 0.35, "loop": -1 },
    { "op": "rotate",    "bone": "leftLowerArm",  "axis": "x", "deg": -24, "dur": 0.175, "loop": -1, "delay": 0.35 },
