# 环境变量模板（复制到 server/.env 并填入实际值）
#
# 【2026-09-20 配置单文件化】唯一生效的运行配置是 server/.env：
#   - Express 后端：dotenv 从 server/ 启动目录读取
#   - game-server：代码显式指定 server/.env（JWT_SECRET 共用）
#   - Prisma：schema.prisma 的 env("DATABASE_URL") 读取
#   前端 vite 不读取任何自定义环境变量（端口写死 vite.config.js=4396），
#   根目录 .env 已删除（曾为 0 消费者的死文件，双文件同名分叉有误导风险）。
# 本文件于 2026-09-20 清理：只保留代码真实消费的变量，
# 删除了 VITE_PORT/VITE_API_BASE/VOLC_EMBED_MODEL/CHAT_RATE_LIMIT/
# SERVER_*（deploy.sh 自带硬编码）/DOMAIN_* 等 0 引用死配置。

# ===== 后端 =====
# development | production（Express 框架标准变量）
NODE_ENV=development
# 后端监听端口（src/index.js）
PORT=3000
# JWT 密钥（生产环境务必更换为随机长串；server/src 3 处引用）
JWT_SECRET=change-me-in-production
# JWT 过期时间
JWT_EXPIRES=7d

# ===== 数据库 =====
# SQLite 文件路径（Prisma schema.prisma env() 读取；相对 server/prisma 目录）
DATABASE_URL=file:./dev.db

# ===== AI 助手（二选一：DeepSeek 官方 或 火山方舟 ARK）=====
# 【当前主通道】DeepSeek 官方 API（2026-09-20 火山 coding 端点到期后切换）
# 只要配置了 DEEPSEEK_API_KEY，llm.js 自动走 DeepSeek 官方通道（文本+视觉同模型）
DEEPSEEK_API_KEY=
# 官方端点（一般无需改）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型 ID：deepseek-flash（DeepSeek-V4.1-Flash，支持图像理解，1M 上下文）
DEEPSEEK_MODEL=deepseek-flash

# ===== 旧通道：火山引擎方舟 ARK（未配 DEEPSEEK_API_KEY 时回退；coding 订阅 2026-09-20 到期）=====
# API Key（在火山引擎控制台获取，填入 server/.env，切勿入库 git）
VOLC_API_KEY=
# 接入地址（方舟 ARK OpenAI 兼容端点）
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# 对话模型 ID
VOLC_MODEL=glm-5.3-flash
# ===== 旧通道视觉模型（仅火山通道使用；DeepSeek 通道识图走主模型）=====
# 视觉模型走标准按量计费端点（与 coding plan 端点不同通道）
VOLC_STD_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 视觉模型 ID（图片理解，输入 0.2 元/百万 tokens）
VOLC_VISION_MODEL=doubao-seed-2-0-mini-260428
# 视觉模型独立 Key（留空则复用 VOLC_API_KEY）
VOLC_VISION_API_KEY=

# ===== 部署信息 =====
# 服务器 IP/账号/密钥/部署目录：以 docs/account-passwords.md 为准（AGENTS 部署纪律）
# 部署入口：bash deploy.sh（脚本自带部署目录配置）
