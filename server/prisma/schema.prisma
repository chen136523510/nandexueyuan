generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  nickname     String?
  avatar       String?
  skinId       String?   // 玩家形象 ID（'1'-'5'），null = 未选择
  role         String    @default("member") // super_admin | admin | member
  status       String    @default("active") // active | disabled
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdCodes   InviteCode[]  @relation("CodeCreator")
  usedCodes      InviteCode[]  @relation("CodeUser")
  importBatches  ImportBatch[] @relation("BatchImporter")
  chatSessions   ChatSession[] @relation("ChatOwner")
  posts          Post[]        @relation("PostAuthor")
  comments       Comment[]     @relation("CommentAuthor")
  likes          Like[]        @relation("PostLiker")
  gameSaves      GameSave[]
  gameProgress   GameProgress?
  feedbacks      Feedback[]    @relation("FeedbackAuthor")
  moduleVisits   ModuleVisit[] @relation("ModuleVisitUser")

  @@map("users")
}

// ===== 师德墙 =====

model Post {
  id        Int      @id @default(autoincrement())
  authorId  Int
  content   String   // 文字内容（最长 500 字）
  image     String?  // 图片路径（/uploads/wall/xxx.jpg）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User      @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]

  @@index([createdAt])
  @@map("posts")
}

model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int
  authorId  Int
  content   String   // 评论内容
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("comments")
}

model Like {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("PostLiker", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId]) // 一人一帖一赞
  @@map("likes")
}

model InviteCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  createdBy Int
  usedBy    Int?
  status    String    @default("unused") // unused | used | expired
  expiresAt DateTime
  createdAt DateTime  @default(now())

  creator User  @relation("CodeCreator", fields: [createdBy], references: [id])
  user    User? @relation("CodeUser", fields: [usedBy], references: [id])

  @@map("invite_codes")
}

model Announcement {
  id        Int       @id @default(1)
  content   String    @default("欢迎来到男德学院")
  updatedAt DateTime  @updatedAt

  @@map("announcements")
}

model Version {
  id        Int      @id @default(autoincrement())
  version   String   @unique // "v1.1.0"
  date      DateTime // 发版日期
  summary   String   @default("") // 公告栏摘要（一句话）
  updates   String   @default("[]") // 本次更新（JSON 数组）
  plans     String   @default("[]") // 未来规划（JSON 数组）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("versions")
}

// ===== AI 助手 =====

model ImportBatch {
  id         Int      @id @default(autoincrement())
  filename   String
  importedBy Int
  count      Int
  skipped    Int
  createdAt  DateTime @default(now())

  user     User           @relation("BatchImporter", fields: [importedBy], references: [id])
  messages GroupMessage[]

  @@map("import_batches")
}

model GroupMessage {
  id        Int      @id @default(autoincrement())
  batchId   Int
  talker    String
  nickname  String?
  content   String
  msgTime   DateTime
  type      String   @default("text")
  createdAt DateTime @default(now())

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([talker, msgTime])
  @@index([talker])
  @@index([msgTime])
  @@map("group_messages")
}

model ChatSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation("ChatOwner", fields: [userId], references: [id])
  turns ChatTurn[]

  @@index([userId])
  @@map("chat_sessions")
}

model ChatTurn {
  id        Int      @id @default(autoincrement())
  sessionId Int
  role      String   // user | assistant
  content   String
  images    String?  // JSON 字符串：用户上传图片的 URL 数组（多模态一期，仅 user turn）
  intent    String?  // statistic | semantic | chat（仅 assistant）
  sources   String?  // JSON 字符串，引用来源
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_turns")
}

// ===== 语义检索：消息分块 + 提示词 =====

model MessageChunk {
  id           Int      @id @default(autoincrement())
  startMsgId   Int      // 起始消息 ID
  endMsgId     Int      // 结束消息 ID
  chunkDate    String?  // 日期（YYYY-MM-DD）
  keywords     String   // 关键提示词（LLM 生成）
  summary      String?  // 简要摘要
  participants String?  // 参与者
  msgCount     Int      // 消息数
  createdAt    DateTime @default(now())

  @@index([chunkDate])
  @@map("message_chunks")
}

// ===== 德塔视觉小说 =====

// 存档槽（每用户最多 10 个手动存档 + 1 个自动存档）
model GameSave {
  id        String   @id @default(cuid())
  userId    Int
  slot      Int      // 0=自动存档, 1-10=手动
  node      String   // 当前剧本节点ID
  chapter   String   // 当前章节
  affinity  String   // JSON: 各角色好感度快照
  variables String   // JSON: 剧情变量快照
  inventory String   @default("[]") // JSON: 背包物品 id 快照
  thumbnail String?  // 存档缩略图（base64）
  spaceState String? @default("{}") // JSON: 空间状态快照（R-035：currentLocation/currentExploreLocation/visitedLocations/unlockedLocations）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slot])
  @@map("game_saves")
}

// 全局进度（好感度/解锁CG/解锁章节/背包，每用户一条）
model GameProgress {
  userId           Int      @id
  unlockedChapters String   @default("[]") // JSON: 已解锁章节列表
  unlockedCGs      String   @default("[]") // JSON: 已解锁CG ID列表
  affinity         String   @default("{}") // JSON: 各角色好感度（跨存档持久化）
  storyVariables   String   @default("{}") // JSON: 全局剧情变量
  inventory        String   @default("[]") // JSON: 背包物品 id 列表（跨存档持久化）
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("game_progress")
}

// 需求反馈（用户提交，男德通 AI 也可生成后经用户确认提交）
model Feedback {
  id        Int      @id @default(autoincrement())
  authorId  Int
  type      String   @default("other")    // optimization（功能优化） | new_feature（功能新增） | story（剧情设计） | bug（BUG反馈）
  title     String                          // 反馈标题
  action    String   @default("无")         // 用户具体的操作（如"点击师德墙进入页面后点击评论"）
  content   String   @default("")           // 详细描述
  status    String   @default("open")       // open | in_progress | resolved
  priority  String   @default("medium")     // low | medium | high
  source    String   @default("manual")     // manual（用户手动提交） | ai（男德通 AI 生成用户确认提交）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User     @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([type])
  @@map("feedbacks")
}

// 模块访问埋点（岁月史书·学院数据）：进入模块记一条，离开时回填停留时长
model ModuleVisit {
  id          Int       @id @default(autoincrement())
  userId      Int
  module      String                    // 模块路由名：home/chat/wall/mailbox/nde/history/character/admin
  enteredAt   DateTime  @default(now()) // 进入时间
  leftAt      DateTime?                 // 离开时间（null=仍在场或异常未上报）
  durationSec Int?                      // 停留秒数（离开时回填；<3s 忽略，>2h 截断挂机）

  user        User      @relation("ModuleVisitUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([module, enteredAt])
  @@index([userId])
  @@map("module_visits")
}
